# Local Docker MySQL ONLY for day-to-day work (docker compose up -d mysql).
# Do NOT put production DigitalOcean MySQL here — `npm run db:seed` wipes wallets/deposits.
DATABASE_URL=mysql://ewallet:ewallet@localhost:3306/ewallet_recon

# Production DB belongs in the host env (Render), not in this file.
# If you must migrate prod from a laptop: set DATABASE_URL in the shell for that
# command only, and never run db:seed against it.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:25060/DB?sslaccept=accept_invalid_certificates

JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_EXPIRES_IN=8h
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Seed refuses remote DBs / NODE_ENV=production unless you set:
# ALLOW_DESTRUCTIVE_SEED=I_UNDERSTAND_DELETE_ALL_DATA
CORS_ORIGIN=http://localhost:5174
# Base URL phones use (embedded in provision QR). Use LAN IP for physical devices.
PUBLIC_API_BASE_URL=http://10.0.2.2:3001
# Matching: amount+time heuristic window (minutes)
MATCH_TIME_WINDOW_MINUTES=15
# Device considered offline after this many minutes without heartbeat
DEVICE_OFFLINE_MINUTES=5
# Banner when offline longer than this (defaults to DEVICE_OFFLINE_MINUTES)
DEVICE_OFFLINE_ALERT_MINUTES=5
# Banner when handset pending SMS queue ≥ this
DEVICE_QUEUE_ALERT_COUNT=5
# Phones with appVersionCode below this show Update required (0=off)
MIN_CAPTURE_VERSION_CODE=7
# Optional Slack/Discord webhook for queue/update alerts
# ALERT_WEBHOOK_URL=
