{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && npm install --workspace=@ewallet/shared --workspace=@ewallet/web",
  "buildCommand": "cd .. && npm run build --workspace=@ewallet/shared && npm run build --workspace=@ewallet/web",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
